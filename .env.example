# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# The SMTP credentials are server-side only; they must never be exposed to the
# browser bundle (no VITE_ prefix, no import.meta.env usage).

# --- SMTP transport (Sumopod) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Verified sender. Must be a domain configured with your SMTP provider —
# sending as an arbitrary @gmail.com address fails SPF/DMARC.
SMTP_FROM=noreply@example.com

# --- Where contact form submissions are delivered ---
CONTACT_TO=you@example.com

# --- Server ---
PORT=3000
